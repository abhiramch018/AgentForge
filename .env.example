# AgentForge environment template — placeholders only. Copy to `.env`.
# Never commit `.env`. Secrets must not appear in images or frontend bundles.

# --- Required auth (shared-token / single-workspace boundary) ---
# One bearer token for all operators. This is NOT multi-user isolation.
ORCHESTRATION_API_TOKEN=change-me-to-a-long-random-token

# Set true only for local unauthenticated experiments (never in Compose prod).
ORCHESTRATION_ALLOW_UNAUTHENTICATED_LOCAL=false

# Single workspace id for memory/approvals scoping.
ORCHESTRATION_WORKSPACE_ID=default

# --- Capacity (per process; API and worker each apply their own limits) ---
ORCHESTRATION_MAX_INFLIGHT_RUNS=2
ORCHESTRATION_MAX_INFLIGHT_TASKS=8
ORCHESTRATION_MAX_RUN_CONCURRENCY=4
ORCHESTRATION_MAX_JOB_ATTEMPTS=2
ORCHESTRATION_JOB_LEASE_MS=120000

# --- Persistence paths (Compose overrides these to /data/*) ---
# ORCHESTRATION_JOBS_DB_PATH=data/jobs.db
# ORCHESTRATION_QUEUE_DB_PATH=data/huey_queue.db
# ORCHESTRATION_MEMORY_DB_PATH=data/memory.db
# ORCHESTRATION_APPROVALS_DB_PATH=data/approvals.db
# ORCHESTRATION_ARTIFACT_OUTPUT_ROOT=data/artifacts

# --- Live LLM provider (required for non-offline Compose profile) ---
# Kept out of images; supplied only via env / .env at runtime.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your-provider-key-here
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=512

# --- Optional telemetry ---
ORCHESTRATION_OTEL_CONSOLE=false
ORCHESTRATION_TELEMETRY_CAPTURE_CONTENT=false

# --- Offline demo flag (set by docker-compose.offline.yml; do not enable with live keys) ---
# ORCHESTRATION_OFFLINE_DEMO=false
